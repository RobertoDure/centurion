# Centurion configuration. Copy to .env and fill in. Never commit .env.

# --- API -------------------------------------------------------------------
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://centurion:centurion@localhost:5432/centurion

# --- Kafka -----------------------------------------------------------------
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=centurion-api
KAFKA_GROUP_ID=centurion-api
KAFKA_TOPIC_RAW=logs.raw
KAFKA_TOPIC_DLQ=logs.dlq
KAFKA_TOPIC_FLAGS=logs.flags
KAFKA_SSL=false
# KAFKA_SASL_MECHANISM=plain            # plain | scram-sha-256 | scram-sha-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=

# --- Jev -------------------------------------------------------------------
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
# Point at the local jev-mock in development. The SDK reads TYPESAFE_BASE_URL,
# so the gateway passes JEV_BASE_URL explicitly as baseURL.
JEV_BASE_URL=http://localhost:8080
JEV_MAX_RPS=10
JEV_TIMEOUT_MS=10000
JEV_MAX_RETRIES=2

# --- Size guard and pipeline ----------------------------------------------
JEV_STATE_QUESTION_TOKEN_LIMIT=32000
JEV_REQUEST_TOKEN_LIMIT=64000
TOKEN_SAFETY_MARGIN=0.1
OVERSIZE_POLICY=chunk                    # chunk | truncate | reject
MAX_CHUNKS=8
CONSUMER_CONCURRENCY=1
PERSIST_ALL_EVALUATIONS=false
EXCERPT_CHARS=0
REDACT_KEYS=
RULE_CACHE_REFRESH_SECONDS=15

# --- Actions ----------------------------------------------------------------
ACTION_MAX_ATTEMPTS=5
ACTION_EXECUTOR_INTERVAL_MS=1000
WEBHOOK_ALLOWED_HOSTS=
# Base64 32-byte key; required in production to encrypt webhook secrets at rest.
SECRETS_ENCRYPTION_KEY=

# --- SSE --------------------------------------------------------------------
SSE_RING_BUFFER_SIZE=500
