{
  "name": "@centurion/client-lib",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Log producer client for Centurion (validates envelopes, publishes to Kafka).",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:coverage": "vitest run --coverage",
    "build": "tsup",
    "example": "tsx examples/send-1000.ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@centurion/contracts": "workspace:*",
    "kafkajs": "^2.2.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
